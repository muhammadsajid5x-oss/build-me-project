{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../packages/**/*.ts",
    "../packages/**/*.tsx",
    "../apps/**/*.ts",
    "../apps/**/*.tsx",
    "../services/**/*.ts",
    "../services/**/*.tsx"
  ]
}
