{
  "name": "build-me-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:unit": "jest --config tests/jest.config.ts",
    "test:integration": "jest --config tests/jest.config.ts",
    "test:e2e": "cypress run",
    "test:api": "newman run \"docs/postman/leads_api.json\" -e \"docs/postman/environment.json\"",
    "test:api:all": "newman run \"docs/postman/leads_api.json\" -e \"docs/postman/environment.json\"",
    "storybook": "storybook dev -p 6006 --config-dir storybook/.storybook",
    "storybook:build": "storybook build --config-dir storybook/.storybook",
    "e2e": "turbo e2e",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@storybook/addon-a11y": "8.6.17",
    "@storybook/addon-docs": "8.6.17",
    "@storybook/addon-essentials": "8.6.17",
    "@storybook/addon-interactions": "8.6.17",
    "@storybook/addon-links": "8.6.17",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/react": "8.6.17",
    "@storybook/react-vite": "8.6.17",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "cypress": "^15.19.0",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.30.5",
    "eslint": "^10.8.0",
    "eslint-plugin-storybook": "^0.11.0",
    "globals": "^17.8.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "newman": "^6.2.2",
    "playwright": "^1.62.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "8.6.17",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "dependencies": {
    "express": "^4.22.2"
  },
  "pnpm": {
    "overrides": {
      "lodash": ">=4.18.0",
      "flatted": "^3.4.2",
      "handlebars": ">=4.7.9",
      "node-forge": ">=1.4.0",
      "qs": ">=6.14.1",
      "underscore": ">=1.13.8"
    }
  }
}
